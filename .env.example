# Chocolate Zone — environment template (placeholders only).
# Copy to `.env.local` (app runtime) / `.env` (CLI & CI) and fill in real values.
# The only committed env artifact is this file — docs/SUPABASE.md §2, docs/DEVOPS.md §3.

# ---- Supabase (public by design — safe in client bundles) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Server only — NEVER prefix with NEXT_PUBLIC_ ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Single admin identity for magic-link auth (docs/AUTH.md) ----
ADMIN_EMAIL=admin@example.com

# ---- App origin used for magic-link redirects (set per environment) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase CLI / CI (never in client bundles) ----
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
